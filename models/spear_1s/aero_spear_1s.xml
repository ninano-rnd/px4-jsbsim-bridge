<aerodynamics>
  <function name="aero/t022/alpha-rad">
    <description>Spear nose-relative AoA from air-relative BODY velocity</description>
    <ifthen>
      <lt>
        <sum>
          <abs><property>velocities/u-aero-fps</property></abs>
          <abs><property>velocities/w-aero-fps</property></abs>
        </sum>
        <value>0.000001</value>
      </lt>
      <value>0</value>
      <atan2>
        <property>velocities/u-aero-fps</property>
        <product><value>-1</value><property>velocities/w-aero-fps</property></product>
      </atan2>
    </ifthen>
  </function>
