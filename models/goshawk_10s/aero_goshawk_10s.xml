<?xml version="1.0" ?>
<!--
    Aerodynamics for Goshawk 10s tailsitter VTOL
    CL/CD use the supplied CFD table (FW AoA -50..90 deg, stored at BODY
    alpha -140..0 deg). Active CM uses the earlier -90..90 deg FW table,
    stored at BODY alpha -180..0 deg; the newer CFD CM remains commented out.
    Remaining sideslip and rate derivatives are inherited Rascal estimates,
    NOT validated by this CFD table. Geometry used for dimensionalization:
      - Wing reference area: 0.4800 m² (5.1667 ft²)
      - Wingspan: 1.2 m (3.9370 ft)
      - Reference chord: 0.2000 m (0.6562 ft)
      - AR: 3.00 (span squared / reference area)
      - Modeled mass: 5 kg (11.0231 lbs)
      - No tail surfaces (differential thrust for yaw)
    Uses JSBSim standard units: qbar-psf, Sw-sqft, bw-ft, cbarw-ft.
    Table abscissas already include the -90 deg FW-to-BODY alpha shift.
    No additional angle shift is applied at runtime. Pitch moment sign is unchanged.
    Confirm CFD normalization uses the same reference area/chord as metrics.
    CM is applied about AERORP; confirm the CFD moment reference point.
    JSBSim adds AERORP-to-CG force moments separately.
    Outside each table's alpha range, values clamp to endpoints (unvalidated).
    No synthetic +10 deg zero-coefficient row or reverse-flow data are added.
    FW axes relative to JSBSim BODY: X_FW=-Z_BODY, Y_FW=Y_BODY, Z_FW=X_BODY.
    Thus p_FW=-r_BODY, q_FW=q_BODY, r_FW=p_BODY, and body moments are
    L_BODY=N_FW, M_BODY=M_FW, N_BODY=-L_FW. ROLL/PITCH/YAW below are BODY axes.
    beta=atan2(v,sqrt(u*u+w*w)) is unchanged by this Y-axis rotation.
    Lift/drag wind axes and the existing native-alpha CFD lookup are retained.
    Cl*/Cn* function names denote the source FW derivative, but their outputs
    include the sign needed for the destination BODY moment axis.
    Active rate damping depends on airspeed; direct hover damping is commented out.
    Legacy aero/coefficient/* functions output forces/moments, not coefficients.
-->
<aerodynamics>

    <!-- ============== DRAG ============== -->
    <axis name="DRAG">
        <function name="aero/coefficient/CDalpha">
            <description>Drag Coefficient with AoA(alpha)</description>
            <product>
                <property>aero/qbar-psf</property>
                <property>metrics/Sw-sqft</property>
                <table>
                    <independentVar lookup="row">aero/alpha-deg</independentVar>
                    <tableData>
                        -140    1.0292
                        -130    0.8572
                        -120    0.6476
                        -110    0.415
                        -100    0.1606
                        -98     0.0955
                        -94     0.0456
                        -90     0.0358
                        -86     0.047
                        -82     0.0756
                        -80     0.0968
                        -78     0.1265
                        -74     0.215
                        -70     0.3093
                        -60     0.6145
                        -50     0.8305
                        -40     1.0125
                        -30     1.1418
                        -20     1.1517
                        -10     0.8838
                        0       0.8336
                    </tableData>
                </table>
            </product>
        </function>
        <!-- No CDbeta: the supplied CD column is a function of alpha, not beta. -->
    </axis>

    <!-- ============== SIDE ============== -->
    <axis name="SIDE">
        <function name="aero/coefficient/CYb">
            <description>Side_force_due_to_beta</description>
            <product>
                <property>aero/qbar-psf</property>
                <property>metrics/Sw-sqft</property>
                <property>aero/beta-rad</property>
                <value>-1.9214</value>
            </product>
        </function>
    </axis>

    <!-- ============== LIFT ============== -->
    <axis name="LIFT">
        <function name="aero/coefficient/CLalpha">
            <description>Lift Coefficient with AoA(alpha)</description>
            <product>
                <property>aero/qbar-psf</property>
                <property>metrics/Sw-sqft</property>
                <table>
                    <independentVar lookup="row">aero/alpha-deg</independentVar>
                    <tableData>
                        -140    -0.7988
                        -130    -0.8956
                        -120    -0.902
                        -110    -0.8099
                        -100    -0.6218
                        -98     -0.6381
                        -94     -0.3227
                        -90     0.0837
                        -86     0.4809
                        -82     0.8637
                        -80     1.0404
                        -78     1.1382
                        -74     1.1302
                        -70     1.1776
                        -60     1.0021
                        -50     0.9445
                        -40     0.8272
                        -30     0.6552
                        -20     0.4172
                        -10     0.1734
                        0       0.0233
                    </tableData>
                </table>
            </product>
        </function>
    </axis>

    <!-- FW roll moment maps to negative BODY yaw moment. -->
    <axis name="YAW">
        <function name="aero/coefficient/Clb">
            <description>BODY yaw: negative FW roll moment due to beta</description>
            <product>
                <property>aero/qbar-psf</property>
                <property>metrics/Sw-sqft</property>
                <property>metrics/bw-ft</property>
                <property>aero/beta-rad</property>
                <!-- N_BODY=-L_FW: negate Cl_beta=-0.002457. -->
                <value>0.002457</value>
            </product>
        </function>
        <function name="aero/coefficient/Clp">
            <description>BODY yaw damping from FW roll-rate derivative</description>
            <product>
                <property>aero/qbar-psf</property>
                <property>metrics/Sw-sqft</property>
                <property>metrics/bw-ft</property>
                <property>aero/bi2vel</property>
                <!-- p_FW=-r_BODY and N_BODY=-L_FW: the two signs cancel. -->
                <property>velocities/r-aero-rad_sec</property>
                <value>-0.4938</value>
            </product>
        </function>
        <function name="aero/coefficient/Clr">
            <description>BODY yaw: negative FW roll moment due to FW yaw rate</description>
            <product>
                <property>aero/qbar-psf</property>
                <property>metrics/Sw-sqft</property>
                <property>metrics/bw-ft</property>
                <property>aero/bi2vel</property>
                <!-- r_FW=p_BODY; negate the resulting FW roll moment. -->
                <property>velocities/p-aero-rad_sec</property>
                <value>-0.002799</value>
            </product>
        </function>
    </axis>

    <!-- ============== PITCH ============== -->
    <axis name="PITCH">
        <function name="aero/coefficient/Cmalpha">
            <description>Pitch_moment_due_to_alpha</description>
            <product>
                <property>aero/qbar-psf</property>
                <property>metrics/Sw-sqft</property>
                <property>metrics/cbarw-ft</property>
                <table>
                    <independentVar lookup="row">aero/alpha-deg</independentVar>
                    <tableData>
                        -180	0.7923
                        -150	0.6180
                        -120	0.2768
                        -110	0.1842
                        -106	0.1419
                        -102	0.1178
                        -98	    0.1143
                        -94	    0.1147
                        -90	    0.0926
                        -86	    -0.0038
                        -82	    -0.0980
                        -78	    -0.1862
                        -74	    -0.2473
                        -70	    -0.2164
                        -60	    -0.2746
                        -30	    -0.5663
                        0	    -0.7522
                    </tableData>
                    <!-- <tableData>
                        -140 0.6558
                        -130 0.7692
                        -120 0.7967
                        -110 0.7398
                        -100 0.5556
                        -98  0.5217
                        -94  0.2776
                        -90 -0.0570
                        -86 -0.3872
                        -82 -0.7041
                        -80 -0.8515
                        -78 -0.9354
                        -74 -0.9515
                        -70 -0.9925
                        -60 -0.8523
                        -50 -0.7786
                        -40 -0.6530
                        -30 -0.4652
                        -20 -0.2089
                        -10 -0.0492
                        0   0.0648
                    </tableData> -->
                </table>
            </product>
        </function>
        <function name="aero/coefficient/Cmq">
            <description>Pitch_moment_due_to_pitch_rate</description>
            <product>
                <property>aero/qbar-psf</property>
                <property>metrics/Sw-sqft</property>
                <property>metrics/cbarw-ft</property>
                <property>aero/ci2vel</property>
                <property>velocities/q-aero-rad_sec</property>
                <value>-77.1609</value>
            </product>
        </function>
        <!-- Direct rate damping for hover (reduced to allow FW pitch authority) -->
        <!-- <function name="aero/moment/Pitch_rate_damp">
            <description>Pitch rate damping (direct, not qbar-dependent)</description>
            <product>
                <value>-8.0</value>
                <property>velocities/q-rad_sec</property>
            </product>
        </function> -->
    </axis>

    <!-- FW yaw moment maps to positive BODY roll moment. -->
    <axis name="ROLL">
        <function name="aero/coefficient/Cnb">
            <description>BODY roll: FW yaw moment due to beta</description>
            <product>
                <property>aero/qbar-psf</property>
                <property>metrics/Sw-sqft</property>
                <property>metrics/bw-ft</property>
                <property>aero/beta-rad</property>
                <value>0.6526</value>
            </product>
        </function>
        <function name="aero/coefficient/Cnr">
            <description>BODY roll damping from FW yaw-rate derivative</description>
            <product>
                <property>aero/qbar-psf</property>
                <property>metrics/Sw-sqft</property>
                <property>metrics/bw-ft</property>
                <property>aero/bi2vel</property>
                <!-- r_FW=p_BODY and L_BODY=N_FW. -->
                <property>velocities/p-aero-rad_sec</property>
                <value>-0.5741</value>
            </product>
        </function>
    </axis>

</aerodynamics>
