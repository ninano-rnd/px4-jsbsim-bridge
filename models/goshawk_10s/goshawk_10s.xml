<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sourceforge.net/JSBSim.xsl"?>
<fdm_config name="goshawk 10s" release="BETA" version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://jsbsim.sourceforge.net/JSBSim.xsd">

    <fileheader>
        <author>Geon-Hong Kim</author>
        <filecreationdate>2026-03-26</filecreationdate>
        <version>$Revision: 1.0 $</version>
        <description>Models a Goshawk 10s tailsitter VTOL</description>
        <license>
            <licenseName>GPL (General Public License)</licenseName>
            <licenseURL>http://www.gnu.org/licenses/gpl.html</licenseURL>
        </license>
        <note>
            This model represents the Goshawk 10s tailsitter VTOL aircraft.

            Aircraft Specifications:
            - Type: Tailsitter VTOL quadplane
            - MTOW: 4 kg (8.82 lbs)
            - Payload: 1 kg (2.21 lbs)
            - Wing Span: 1.2 m (3.94 ft)
            - Wing Area: 0.2 m² (2.15 ft²)
            - Mean Chord: 0.1667 m (0.547 ft)
            - Aspect Ratio: 7.20
            - Cruise Speed: 22 m/s (79.2 km/h)
            - Endurance: 30 min
            - Max Altitude: 500 m

            Propulsion:
            - 4x T-Motor AT3520 550KV brushless motors
            - Max thrust per motor: 11.114 kg (109.1 N)
            - Total max thrust: 44.456 kg (436.4 N)
            - Max power per motor: 2685 W
            - Battery: 12S LiPo (46V nominal)

            Motor Configuration (X-layout):
            - Motor 0: Front-Right (Counter-Clockwise)
            - Motor 1: Aft-Left (Counter-Clockwise)
            - Motor 2: Front-Left (Clockwise)
            - Motor 3: Aft-Right (Clockwise)

            Motor Physical Layout:
            - Longitudinal spacing: 614.11 mm (24.18 in)
            - Lateral spacing: 1545.48 mm (60.85 in)

            Control:
            - No traditional control surfaces
            - Attitude control via differential thrust only
            - Direct motor control via PX4 Autopilot SITL interface

            Coordinate System:
            - Aircraft oriented as tailsitter (fuselage vertical in hover)
            - Body frame: X-forward, Y-right wing, Z-down
            - Hover orientation: pitch -90 degrees from level flight
        </note>
    </fileheader>

    <metrics file="metrics_goshawk_10s.xml"/>
    <mass_balance file="mass_goshawk_10s.xml"/>
    <ground_reactions file="gear_goshawk_10s.xml"/>
    <propulsion file="propulsion_goshawk_10s.xml"/>
    <system file="effectors_goshawk_10s.xml"/>
    <aerodynamics file="aero_goshawk_10s.xml"/>

    <system file="px4_default_imu_sensor"/>
    <system file="px4_default_gps_sensor"/>
    <system file="px4_default_baro_sensor"/>

    <!-- Attitude debug output via UDP (port 5762) — remove after confirming initial pose -->
    <output name="localhost" type="SOCKET" protocol="UDP" port="5762" rate="1">
        <property>attitude/phi-deg</property>
        <property>attitude/theta-deg</property>
        <property>attitude/psi-deg</property>
        <property>position/h-sl-meters</property>
        <property>velocities/vt-fps</property>
        <property>px4/acc-x</property>
        <property>px4/acc-y</property>
        <property>px4/acc-z</property>
    </output>

    <!-- monitor_goshawk.py: time is prepended by JSBSim; property order must match.
         CLalpha/CDalpha are forces in lbf, not dimensionless coefficients. -->
    <output name="127.0.0.1" type="SOCKET" protocol="UDP" port="5764" rate="10">
        <property>aero/alpha-deg</property>
        <property>aero/coefficient/CLalpha</property>
        <property>aero/coefficient/CDalpha</property>
        <property>aero/qbar-psf</property>
        <property>metrics/Sw-sqft</property>
        <property>propulsion/engine[0]/thrust-lbs</property>
        <property>propulsion/engine[1]/thrust-lbs</property>
        <property>propulsion/engine[2]/thrust-lbs</property>
        <property>propulsion/engine[3]/thrust-lbs</property>
        <property>velocities/vt-fps</property>
        <property>propulsion/engine[0]/propeller-rpm</property>
        <property>propulsion/engine[1]/propeller-rpm</property>
        <property>propulsion/engine[2]/propeller-rpm</property>
        <property>propulsion/engine[3]/propeller-rpm</property>
        <property>attitude/phi-deg</property>
        <property>attitude/theta-deg</property>
        <property>attitude/psi-deg</property>
    </output>

    <!-- Native CSV diagnostic log (independent of the UDP monitor and PX4 ULog).
         sitl_run.sh gives each Goshawk run its own working directory.
         JSBSim prepends simulation time [s]. BODY Y is also FW pitch:
         positive moment/rate is nose-up. Moments are lbf*ft, not N*m.
         m-aero includes the AERORP-to-CG force moment; do not add CM again. -->
    <output name="goshawk_moments.csv" type="CSV" rate="50">
        <property>moments/m-prop-lbsft</property>
        <property>moments/m-aero-lbsft</property>
        <property>moments/m-total-lbsft</property>
        <property>moments/m-gear-lbsft</property>
        <property>aero/coefficient/Cmalpha</property>
        <property>aero/coefficient/Cmq</property>
        <property>velocities/q-rad_sec</property>
        <property>accelerations/qdot-rad_sec2</property>
        <property>velocities/p-rad_sec</property>
        <property>velocities/r-rad_sec</property>
        <property>velocities/q-aero-rad_sec</property>
        <property>attitude/phi-deg</property>
        <property>attitude/theta-deg</property>
        <property>attitude/psi-deg</property>
        <property>aero/alpha-deg</property>
        <property>aero/beta-deg</property>
        <property>aero/qbar-psf</property>
        <property>velocities/vt-fps</property>
        <property>velocities/v-north-fps</property>
        <property>velocities/v-east-fps</property>
        <property>velocities/v-down-fps</property>
        <property>position/h-sl-meters</property>
        <property>aero/coefficient/CLalpha</property>
        <property>aero/coefficient/CDalpha</property>
        <property>fcs/esc-cmd-norm[0]</property>
        <property>fcs/esc-cmd-norm[1]</property>
        <property>fcs/esc-cmd-norm[2]</property>
        <property>fcs/esc-cmd-norm[3]</property>
        <property>fcs/throttle-pos-norm[0]</property>
        <property>fcs/throttle-pos-norm[1]</property>
        <property>fcs/throttle-pos-norm[2]</property>
        <property>fcs/throttle-pos-norm[3]</property>
        <property>propulsion/engine[0]/thrust-lbs</property>
        <property>propulsion/engine[1]/thrust-lbs</property>
        <property>propulsion/engine[2]/thrust-lbs</property>
        <property>propulsion/engine[3]/thrust-lbs</property>
        <property>propulsion/engine[0]/propeller-rpm</property>
        <property>propulsion/engine[1]/propeller-rpm</property>
        <property>propulsion/engine[2]/propeller-rpm</property>
        <property>propulsion/engine[3]/propeller-rpm</property>
    </output>

</fdm_config>
